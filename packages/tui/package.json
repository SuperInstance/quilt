{
  "name": "@superinstance/quilt-tui",
  "version": "0.3.0",
  "description": "Terminal UI for Quilt \u2014 the power-tool view of a running engine.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "quilt-tui": "bin/quilt-tui"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "tsx bin/quilt-tui",
    "dev": "tsx watch bin/quilt-tui",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "node --test --import tsx src/*.test.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@superinstance/quilt-core": "^0.3.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "types": "./dist/index.d.ts"
}
