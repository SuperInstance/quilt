{
  "name": "quilt",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A spreadsheet where every cell is a live, addressable capability. The grid is the runtime.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superinstance/quilt.git"
  },
  "bugs": {
    "url": "https://github.com/superinstance/quilt/issues"
  },
  "homepage": "https://github.com/superinstance/quilt#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @quilt/core -w @quilt/sdk -w @quilt/mcp -w @quilt/tui -w @quilt/cli --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:core": "cd packages/core && npm run test",
    "dev": "cd packages/cli && npm run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "echo 'format placeholder'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "globals": "^17.0.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.4"
  }
}
